---
import Layout from '../components/Layout.astro';
import { languages } from '../i18n.js';
const lang = 'es';
const t = languages[lang];

const toursData = [
  {
    name: 'Tour de Cacao',
    description: 'Del grano a la barra, recorrido por la plantación de cacao, degustaciones y actividades prácticas de elaboración de chocolate orgánico.',
    duration: 'PT2H30M',
    price: 45,
  },
  {
    name: 'Tour de Día Completo a Corcovado',
    description: 'Excursión al Parque Nacional Corcovado con transporte desde Puerto Jiménez a Sirena, guía certificado, almuerzo y entrada al parque.',
    duration: 'PT8H',
    price: 95,
  },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://ranchoraices.com/tours#page',
    name: 'Tours de Chocolate y Cacao en Península de Osa | Rancho Raíces',
    url: 'https://ranchoraices.com/tours',
    isPartOf: { '@id': 'https://ranchoraices.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: toursData.map((tour, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Tour',
          name: tour.name,
          description: tour.description,
          provider: { '@id': 'https://ranchoraices.com/#organization' },
          duration: tour.duration,
          offers: {
            '@type': 'Offer',
            price: tour.price,
            priceCurrency: 'USD',
            availability: 'https://schema.org/InStock',
          },
        },
      })),
    },
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://ranchoraices.com/tours#faq',
    mainEntity: [
      {
        '@type': 'Question',
        name: '¿Cuánto cuesta el tour de cacao?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'El Tour de Cacao cuesta $45 USD por persona e incluye recorrido por la finca, degustaciones y actividades prácticas.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Cuánto dura el tour de cacao?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'El Tour de Cacao dura aproximadamente 2 a 2.5 horas.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Qué incluye el tour de día completo a Corcovado?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Incluye entrada al Parque Nacional Corcovado, transporte de Puerto Jiménez a Sirena, guía certificado y almuerzo. Dura de 6 a 8 horas y cuesta $95 USD por persona.',
        },
      },
        {
          '@type': 'Question',
          name: '¿El transporte está incluido en el Tour de Cacao?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El transporte no está incluido. Ofrecemos servicio de taxi opcional (solo ida, un trayecto — no ida y vuelta): $25 USD por vía desde el centro de Puerto Jiménez y $30 USD por vía desde Hotel Botánica. Ida y vuelta sería $50 / $60 respectivamente. Otras ubicaciones varían según la distancia. Precio por servicio de taxi (un trayecto), no por persona.',
          },
        },
      {
        '@type': 'Question',
        name: '¿Cómo puedo reservar un tour?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Puedes reservar contactándonos por WhatsApp al +506 8639 4010 o escribiéndonos a info@ranchoraices.com.',
        },
      },
    ],
  },
];
---

<Layout
  url={Astro.url}
  title="Tours de Chocolate y Cacao en Península de Osa | Rancho Raíces"
  description="Tour de cacao artesanal de 2-2.5 h por $45 USD y tour de día completo a Corcovado por $95 USD con guía certificado. Turismo rural y sostenible en Puerto Jiménez, Costa Rica."
  image="/og-image.jpg"
  type="website"
  jsonLd={jsonLd}
>
  <section class="py-16 px-4 md:px-0 max-w-4xl mx-auto">
    <h1 class="font-display text-3xl md:text-5xl text-amber-900 mb-6">{t.tours}</h1>
    <p class="text-lg text-gray-800 mb-6">Descubre nuestros tours de chocolate artesanal y vive la experiencia completa de la finca Rancho Raíces.</p>
    <div class="grid gap-8 md:grid-cols-2">
      <div class="bg-amber-50 rounded-xl shadow p-6 border border-amber-300">
        <h2 class="font-display text-2xl text-amber-900 mb-2">Tour de Cacao</h2>
        <ul class="mb-2 text-gray-700 text-base list-disc list-inside">
          <li>Duración: 2-2.5 horas</li>
          <li>Precio: $45 USD por persona</li>
          <li>Incluye recorrido, degustaciones, actividades prácticas</li>
        </ul>
        <p class="mt-3 text-sm text-gray-600 bg-white rounded-lg p-3 border border-amber-200">
          <span class="font-semibold text-amber-900">Transporte no incluido:</span> servicio de taxi opcional <span class="font-semibold">$25 USD por vía (solo ida)</span> desde el centro de Puerto Jiménez y <span class="font-semibold">$30 USD por vía (solo ida)</span> desde Hotel Botánica. <span class="text-xs">Un trayecto — no ida y vuelta. Ida y vuelta: $50 / $60.</span> Otras ubicaciones: tarifa según distancia. Precio por servicio de taxi (no por persona).
        </p>
        <a href="/contact" class="inline-block mt-2 px-6 py-2 rounded bg-amber-400 text-amber-900 font-semibold hover:bg-green-600 hover:text-white transition">Reservar</a>
      </div>
      <div class="bg-amber-50 rounded-xl shadow p-6 border border-amber-300">
        <h2 class="font-display text-2xl text-amber-900 mb-2">Tour de Día Completo a Corcovado</h2>
        <ul class="mb-2 text-gray-700 text-base list-disc list-inside">
          <li>Duración: 6-8 horas</li>
          <li>Precio: $95 USD por persona</li>
          <li>Entrada al Parque Nacional Corcovado</li>
          <li>Transporte de Puerto Jiménez a Sirena</li>
          <li>Guía Certificado</li>
          <li>Almuerzo</li>
        </ul>
        <a href="/contact" class="inline-block mt-2 px-6 py-2 rounded bg-amber-400 text-amber-900 font-semibold hover:bg-green-600 hover:text-white transition">Reservar</a>
      </div>
    </div>
    <div class="mt-10 text-gray-800">
      <h3 class="font-display text-xl text-amber-900 mb-2">¿Por qué elegirnos?</h3>
      <ul class="list-disc list-inside text-gray-700">
        <li>Experiencia auténtica y rural</li>
        <li>Guías certificados y trato familiar</li>
        <li>Enfoque en sostenibilidad y permacultura</li>
        <li>Ideal para familias, parejas y grupos</li>
      </ul>
    </div>

    <div class="mt-12">
      <h2 class="font-display text-3xl text-amber-900 mb-6">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        <div class="bg-amber-50 rounded-xl shadow p-6">
          <h3 class="font-semibold text-amber-900 mb-2">¿Cuánto cuesta el tour de cacao?</h3>
          <p class="text-gray-700">El Tour de Cacao cuesta $45 USD por persona e incluye recorrido por la finca, degustaciones y actividades prácticas.</p>
        </div>
        <div class="bg-amber-50 rounded-xl shadow p-6">
          <h3 class="font-semibold text-amber-900 mb-2">¿Cuánto dura el tour de cacao?</h3>
          <p class="text-gray-700">El Tour de Cacao dura aproximadamente 2 a 2.5 horas.</p>
        </div>
        <div class="bg-amber-50 rounded-xl shadow p-6">
          <h3 class="font-semibold text-amber-900 mb-2">¿Qué incluye el tour de día completo a Corcovado?</h3>
          <p class="text-gray-700">Incluye entrada al Parque Nacional Corcovado, transporte de Puerto Jiménez a Sirena, guía certificado y almuerzo. Dura de 6 a 8 horas y cuesta $95 USD por persona.</p>
        </div>
        <div class="bg-amber-50 rounded-xl shadow p-6">
          <h3 class="font-semibold text-amber-900 mb-2">¿El transporte está incluido en el Tour de Cacao?</h3>
          <p class="text-gray-700">No, el transporte no está incluido. Ofrecemos servicio de taxi opcional <strong>por vía (solo ida, un trayecto — no ida y vuelta)</strong>: <strong>$25 USD solo ida</strong> desde el centro de Puerto Jiménez y <strong>$30 USD solo ida</strong> desde Hotel Botánica (ida y vuelta $50 / $60). Otras ubicaciones varían según la distancia. Precio por servicio de taxi, no por persona.</p>
        </div>
        <div class="bg-amber-50 rounded-xl shadow p-6">
          <h3 class="font-semibold text-amber-900 mb-2">¿Cómo puedo reservar un tour?</h3>
          <p class="text-gray-700">Puedes reservar contactándonos por WhatsApp al +506 8639 4010 o escribiéndonos a info@ranchoraices.com.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
