---
import Layout from '../components/Layout.astro';
import Accommodations from '../components/Accommodations.astro';
import { languages } from '../i18n.js';
import { accommodations as rawAccommodations } from '../data/accommodations.js';
const lang = 'es';
const t = languages[lang];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://ranchoraices.com/accommodations#page',
    name: 'Hospedajes en Puerto Jiménez y Península de Osa | Rancho Raíces',
    url: 'https://ranchoraices.com/accommodations',
    isPartOf: { '@id': 'https://ranchoraices.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: rawAccommodations.map((acc, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'LodgingBusiness',
          name: acc.name,
          url: `https://ranchoraices.com/accommodations/${acc.slug}`,
          description: acc.description[lang],
          address: {
            '@type': 'PostalAddress',
            streetAddress: acc.location,
            addressCountry: 'CR',
          },
        },
      })),
    },
  },
];
---

<Layout
  url={Astro.url}
  title="Hospedajes en Puerto Jiménez y Península de Osa | Rancho Raíces"
  description="Hospedajes recomendados cerca de Rancho Raíces: villas y cabinas con WiFi gratis, jardín, cocina equipada y proximidad al Parque Nacional Corcovado, Península de Osa, Costa Rica."
  image="/og-image.jpg"
  type="website"
  jsonLd={jsonLd}
>
  <section class="py-16 px-4 md:px-0 max-w-6xl mx-auto">
    <h1 class="font-display text-3xl md:text-5xl text-amber-900 mb-6 text-center">{t.accommodations}</h1>
    <p class="text-lg text-gray-800 mb-12 text-center max-w-3xl mx-auto">
      Descubre opciones de hospedaje recomendadas cerca de Rancho Raíces. Cada lugar ofrece comodidad y proximidad a la naturaleza de la Península de Osa.
    </p>
    <Accommodations lang={lang} client:load />
  </section>
</Layout>