---
import Layout from '../components/Layout.astro';
import { Image } from 'astro:assets';
import josueImage from '../assets/images/josue.webp';
import { languages } from '../i18n.js';

const lang = 'es';
const t = languages[lang];

const jsonLd = [
  {
    '@type': ['TouristAttraction', 'LocalBusiness'],
    '@id': 'https://ranchoraices.com/#attraction',
    name: 'Rancho Raíces',
    description: 'Finca familiar en Puerto Jiménez, Península de Osa, Costa Rica, dedicada al turismo rural sostenible y a la producción artesanal de chocolate orgánico.',
    url: 'https://ranchoraices.com/',
    image: 'https://ranchoraices.com/og-image.jpg',
    telephone: '+506 8639 4010',
    email: 'info@ranchoraices.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Puerto Jiménez',
      addressRegion: 'Puntarenas',
      addressCountry: 'CR',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 8.54,
      longitude: -83.3,
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '08:00',
        closes: '14:00',
      },
    ],
    parentOrganization: { '@id': 'https://ranchoraices.com/#organization' },
  },
];

const features = [
  {
    title: 'Tours de Cacao y Chocolate',
    description: 'Del grano a la barra, vive el proceso artesanal de nuestro chocolate orgánico.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-amber-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M15.5 8.5c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5z"/><path d="M8.5 15.5c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5z"/><path d="M12 12l3.5-3.5"/><path d="M8.5 8.5L12 12"/></svg>`
  },
  {
    title: 'Experiencias Sostenibles',
    description: 'Aprende sobre permacultura y nuestras prácticas de agricultura regenerativa.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-amber-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`
  },
  {
    title: 'Fauna y Flora Tropical',
    description: 'Descubre la increíble biodiversidad que nos rodea en la mágica Península de Osa.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-amber-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 17.5c3.3-3.3 3.3-8.7 0-12-3.3-3.3-8.7-3.3-12 0-3.3 3.3-3.3 8.7 0 12 3.3 3.3 8.7 3.3 12 0z"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>`
  },
  {
    title: 'Almuerzos y Catas',
    description: 'Disfruta de un almuerzo típico costarricense y catas de nuestro delicioso chocolate.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-amber-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21h20"/><path d="M3 17h18v-4a8 8 0 0 0-16 0v4z"/><path d="M12 4v2"/><path d="M12 11v6"/></svg>`
  }
];
---
<Layout
  url={Astro.url}
  title="Rancho Raíces | Tours de Chocolate Orgánico en Península de Osa, Costa Rica"
  description="Tour de cacao orgánico en Puerto Jiménez, Península de Osa, Costa Rica. Del grano a la barra: chocolate artesanal, permacultura, fauna tropical, almuerzo típico y catas. ¡Reserva tu tour!"
  image="/og-image.jpg"
  type="website"
  jsonLd={jsonLd}
>

  <section
    class="relative flex flex-col items-center justify-center min-h-screen text-center bg-cover bg-center -mt-20 pt-16"
    style="background-image: url('/images/gallery/56.jpg');"
  >
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 bg-green-600 opacity-10 pointer-events-none" style="background-image: url('/leaves-bg.svg'); background-repeat: repeat;"></div>
    <div class="relative z-10 px-4 md:px-0">
      <h1 class="font-display text-4xl md:text-6xl text-white font-bold drop-shadow-lg mb-6 animate-fade-in">
        {t.heroTitle}
      </h1>
      <p class="text-xl md:text-2xl text-amber-50 max-w-3xl mx-auto mb-8 animate-fade-in delay-200">
        {t.heroSubtitle}
      </p>
      <a href="/tours" class="inline-block px-8 py-4 rounded-lg bg-amber-400 text-amber-900 font-bold text-lg shadow-lg hover:bg-green-600 hover:text-white transition-transform hover:scale-105 animate-fade-in delay-400">
        {t.cta}
      </a>
    </div>
  </section>

  <section class="py-20 px-4 bg-amber-50">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl text-amber-900 mb-4">Una Experiencia Inolvidable</h2>
      <p class="text-lg text-gray-700 mb-12 max-w-3xl mx-auto">
        Un lugar donde el chocolate orgánico, la naturaleza y la cultura costarricense se unen. Descubre nuestros tours, aprende sobre permacultura y vive la magia de la Península de Osa.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map(feature => (
          <div class="bg-white p-6 rounded-lg shadow-lg text-center flex flex-col items-center transform hover:-translate-y-2 transition-transform duration-300">
            <div class="mb-4" set:html={feature.icon} />
            <h3 class="font-display text-xl text-amber-900 mb-2">{feature.title}</h3>
            <p class="text-gray-600 text-base">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Private Transportation -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="bg-gradient-to-br from-amber-900 to-amber-800 rounded-3xl p-8 md:p-10 shadow-xl flex flex-col md:flex-row items-center gap-8">
        <div class="flex-1 text-center md:text-left">
          <p class="text-amber-300 font-semibold tracking-widest uppercase text-xs mb-2">Nuevo Servicio · Hasta 8 pasajeros</p>
          <h2 class="font-display text-3xl md:text-4xl text-white mb-3">Transporte Privado en Costa Rica</h2>
          <p class="text-amber-100 mb-4 leading-relaxed">Viaja cómodo y a tu ritmo con chofer privado. Traslados aeropuerto (SJO, Quepos, Golfito, Puerto Jiménez), hotel a hotel y viajes largos por todo el país. Sin shuttles compartidos.</p>
          <ul class="text-amber-200 text-sm text-left max-w-md mx-auto md:mx-0 space-y-1 mb-6">
            <li><i class="fas fa-check text-amber-400 mr-2"></i>Conductor: Eric Levasseur — Francés · Español · Inglés</li>
            <li><i class="fas fa-check text-amber-400 mr-2"></i>Taxi local al Tour de Cacao: $25 centro PJ / $30 Botánica por vía (solo ida)</li>
          </ul>
          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
            <a href="/transporte-privado" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-amber-400 text-amber-900 font-bold hover:bg-white transition">Ver Transporte Privado</a>
            <a href="https://wa.me/50686394010?text=Hola%2C%20quisiera%20cotizar%20transporte%20privado%20" target="_blank" rel="noopener" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 border border-white/20 text-white font-semibold hover:bg-white hover:text-amber-900 transition"><i class="fab fa-whatsapp mr-2"></i> Cotizar por WhatsApp</a>
          </div>
        </div>
        <div class="flex-shrink-0 bg-white rounded-2xl p-6 text-center max-w-xs w-full">
          <div class="w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center mx-auto mb-3 text-amber-900 text-2xl"><i class="fas fa-van-shuttle"></i></div>
          <p class="font-bold text-amber-900">¿A dónde te llevamos?</p>
          <p class="text-sm text-gray-600 mt-1">San José · Manuel Antonio · Dominical · Uvita · Sierpe · Puerto Jiménez · Golfito y más</p>
          <p class="text-xs text-gray-500 mt-3">Cotización personalizada según ruta, fecha, pasajeros y equipaje.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Fundraising Section for Josué -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-gradient-to-br from-green-700 to-green-600 rounded-3xl p-8 md:p-12 shadow-2xl">
        <div class="mb-6 overflow-hidden rounded-2xl shadow-xl max-w-2xl mx-auto">
          <Image
            src={josueImage}
            alt="Josué"
            class="block w-full h-64 object-cover object-top"
          />
        </div>
        <h2 class="font-display text-3xl md:text-4xl text-white mb-3">{t.fundraisingTitle}</h2>
        <p class="text-xl text-amber-200 mb-4 font-semibold">{t.fundraisingSubtitle}</p>
        <p class="text-lg text-green-50 mb-8 max-w-2xl mx-auto leading-relaxed">
          {t.fundraisingDesc}
        </p>
        <a href={t.fundraisingLink} target="_blank" rel="noopener noreferrer" 
           class="inline-flex items-center px-8 py-4 rounded-full bg-amber-400 text-amber-900 font-bold text-lg shadow-lg hover:bg-amber-300 hover:scale-105 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          {t.fundraisingButton}
        </a>
        <p class="mt-4 text-sm text-green-200">gogetfunding.com/a-prosthetic-leg-for-josue</p>
      </div>
    </div>
  </section>

</Layout>
