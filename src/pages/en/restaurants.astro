---
import Layout from '../../components/Layout.astro';
import Restaurants from '../../components/Restaurants.astro';
import { languages } from '../../i18n.js';
import { restaurants as rawRestaurants } from '../../data/restaurants.js';
const lang = 'en';
const t = languages[lang];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://ranchoraices.com/en/restaurants#page',
    name: 'Recommended restaurants in the Osa Peninsula | Rancho Raíces',
    url: 'https://ranchoraices.com/en/restaurants',
    isPartOf: { '@id': 'https://ranchoraices.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: rawRestaurants.map((rest, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Restaurant',
          name: rest.name,
          url: `https://ranchoraices.com/en/restaurants/${rest.slug}`,
          description: rest.description[lang],
          address: {
            '@type': 'PostalAddress',
            streetAddress: rest.location,
            addressCountry: 'CR',
          },
        },
      })),
    },
  },
];
---

<Layout
  url={Astro.url}
  title="Recommended Restaurants in Osa Peninsula | Rancho Raíces"
  description="Recommended restaurants near Rancho Raíces: typical Costa Rican food, seafood, ceviches and unique culinary experiences in the Osa Peninsula, Costa Rica."
  image="/og-image.jpg"
  type="website"
  jsonLd={jsonLd}
>
  <section class="py-16 px-4 md:px-0 max-w-6xl mx-auto">
    <h1 class="font-display text-3xl md:text-5xl text-amber-900 mb-6 text-center">{t.restaurants}</h1>
    <p class="text-lg text-gray-800 mb-12 text-center max-w-3xl mx-auto">
      Discover recommended restaurants near Rancho Raíces. Each place offers delicious food and a unique culinary experience in the Osa Peninsula.
    </p>
    <Restaurants lang={lang} client:load />
  </section>
</Layout>